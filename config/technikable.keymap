#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BAS_L 0
#define NAV_L 1
#define NUM_L 2
#define SYM_L 3

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt {
    quick_tap_ms = <200>;
    tapping-term-ms = <200>;
};

/ {
    chosen { zmk,matrix_transform = &dual_2u_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        taskmanager: taskmanager {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp ESCAPE>;
            label = "TASKMANAGER";
        };

        Copy: Copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(S)>;
            label = "COPY";
        };

        Paste: Paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(V)>;
            label = "PASTE";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&mt TILDE ESC  &kp Q  &kp W      &kp E         &kp R                &kp T               &kp Y  &kp U                &kp I                &kp O                 &kp P              &kp BACKSPACE
&kp TAB        &kp A  &kp S      &kp D         &kp F                &kp G               &kp H  &kp J                &kp K                &kp L                 &mt COLON SEMI     &mt DOUBLE_QUOTES SINGLE_QUOTE
&kp LSHFT      &kp Z  &kp X      &kp C         &kp V                &kp B               &kp N  &kp M                &mt LESS_THAN COMMA  &mt GREATER_THAN DOT  &mt QUESTION FSLH  &kp RET
                      &kp LCTRL  &kp LEFT_ALT  &lt 1 RIGHT_COMMAND         &lt 2 SPACE         &lt 3 RIGHT_COMMAND  &kp UNDER
            >;
        };

        num_layer {
            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5         &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &none
&none      &none         &none         &none         &none         &none                &none         &kp PERIOD    &kp QUESTION  &kp EXCL      &none         &none
&none      &none         &none         &none         &none         &none                &none         &none         &none         &none         &none         &none
                         &none         &none         &trans                      &none                &none         &none
            >;
        };

        nav_layer {
            bindings = <
&kp ESCAPE     &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER          &kp PLUS  &kp MINUS  &kp ASTERISK  &kp SLASH    &kp EQUAL  &kp PIPE
&kp BACKSLASH  &kp DOLLAR     &kp AMPERSAND     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none              &kp LEFT  &kp DOWN   &kp UP_ARROW  &kp RIGHT    &none      &none
&trans         &none          &none             &kp LEFT_BRACE        &kp RIGHT_BRACE        &none              &kp AT    &kp HASH   &kp CARET     &kp PERCENT  &none      &none
                              &none             &none                 &trans                            &trans            &none      &none
            >;
        };

        bt_pwr_layer {
            bindings = <
&trans  &trans  &trans        &trans        &trans  &trans          &trans  &trans          &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans  &trans          &trans  &trans          &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans  &trans          &trans  &trans          &trans  &trans  &trans  &trans
                &bt BT_SEL 0  &bt BT_SEL 1  &trans          &trans          &bt BT_CLR_ALL  &none
            >;
        };
    };
};
